<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.infrastructure.dao.IMerchantProductDao">

    <resultMap id="BaseResultMap" type="cn.bugstack.infrastructure.dao.po.MerchantProductPO">
        <id column="id" property="id"/>
        <result column="goods_id" property="goodsId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="original_price" property="originalPrice"/>
        <result column="group_price" property="groupPrice"/>
        <result column="stock" property="stock"/>
        <result column="image_url" property="imageUrl"/>
        <result column="status" property="status"/>
        <result column="sales_count" property="salesCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="queryProductList" resultMap="BaseResultMap">
        SELECT * FROM merchant_product
        <where>
            <if test="goodsName != null and goodsName != ''">
                AND name LIKE CONCAT('%', #{goodsName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="queryByGoodsId" resultMap="BaseResultMap">
        SELECT * FROM merchant_product WHERE goods_id = #{goodsId}
    </select>

    <insert id="insert" parameterType="cn.bugstack.infrastructure.dao.po.MerchantProductPO">
        INSERT INTO merchant_product (goods_id, name, description, original_price, group_price, stock, image_url, status, sales_count, create_time, update_time)
        VALUES (#{goodsId}, #{name}, #{description}, #{originalPrice}, #{groupPrice}, #{stock}, #{imageUrl}, #{status}, 0, NOW(), NOW())
    </insert>

    <update id="update" parameterType="cn.bugstack.infrastructure.dao.po.MerchantProductPO">
        UPDATE merchant_product
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="groupPrice != null">group_price = #{groupPrice},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="salesCount != null">sales_count = #{salesCount},</if>
            update_time = NOW()
        </set>
        WHERE goods_id = #{goodsId}
    </update>

    <delete id="deleteByGoodsId">
        DELETE FROM merchant_product WHERE goods_id = #{goodsId}
    </delete>

</mapper>
